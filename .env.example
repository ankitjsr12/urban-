# ────────────────────────────────────────────────────
# AI UrbanSense Backend — Environment Configuration
# Copy to .env and fill in your values
# ────────────────────────────────────────────────────

# ── Database (PostGIS) ──────────────────────────────
# Local:  postgresql+asyncpg://urbansense:urbansense@localhost:5432/urbansense
# Neon:   postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/urbansense?ssl=require
DATABASE_URL=postgresql+asyncpg://urbansense:urbansense@localhost:5432/urbansense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urbansense
POSTGRES_USER=urbansense
POSTGRES_PASSWORD=urbansense

# ── Authentication ──────────────────────────────────
# IMPORTANT: Change this in production! Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Redis ───────────────────────────────────────────
# Local:   redis://localhost:6379/0
# Upstash: rediss://default:xxxxx@us1-xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (S3-compatible) ──────────────────
# Providers: minio (local), s3 (AWS/R2/any S3-compatible)
# Local MinIO:      endpoint=http://localhost:9000, key=minioadmin
# Cloudflare R2:    endpoint=https://<account-id>.r2.cloudflarestorage.com, region=auto
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=urbansense-evidence
S3_REGION=us-east-1

# ── Push Notifications (optional) ───────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# ── AI Service ──────────────────────────────────────
# Leave empty to disable AI features (YOLO/OCR)
AI_SERVICE_URL=http://localhost:8001

# ── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins
# Add your Vercel/frontend domain in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Rate Limiting & Uploads ─────────────────────────
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=52428800

# ── AI Model Configuration ─────────────────────────
ANPR_MIN_VERIFIED_CONFIDENCE=0.85
YOLO_MODEL_PATH=YOLO/models/yolov8n.pt
YOLO_CONFIDENCE=0.40
OCR_ENABLED=true
